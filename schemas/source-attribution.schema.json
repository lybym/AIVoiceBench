{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aivoicebench.local/schemas/source-attribution.schema.json",
  "title": "SourceAttribution 1.0.0",
  "description": "Maps diarization speaker IDs to tester/device/unknown roles using evidence. Separate from diarization — does not infer roles from time order or speaker count. Semantic roles are machine proposals with uncalibrated model confidence and stay needs_review; explicit or human evidence is never silently overridden.",
  "type": "object",
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "document_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$" },
    "speaker_segments_ref": {
      "type": ["string", "null"],
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "status": {
      "enum": ["complete", "partial", "insufficient_evidence"]
    },
    "reason": { "type": ["string", "null"] },
    "scope": {
      "description": "Binds these role results to one speaker-output revision and one analysis revision. A role mapping from an older clustering must never be reused for a new one.",
      "type": "object",
      "properties": {
        "recording_sha256": { "type": ["string", "null"] },
        "analysis_id": { "type": ["string", "null"] },
        "speaker_segments_ref": { "type": ["string", "null"] },
        "speaker_output_revision": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "policy": { "type": ["string", "null"] },
    "notes": { "type": ["string", "null"] },
    "semantic_status": {
      "description": "Outcome of the optional semantic attempt, recorded separately from the role result itself.",
      "enum": ["proposed", "not_configured", "insufficient_input", "invalid_output", "failed", null]
    },
    "invocations": {
      "description": "Semantic provider call records. Never contains credentials or raw prompts.",
      "type": "array",
      "items": { "type": "object" }
    },
    "conflicts": {
      "description": "Clusters where semantic proposals disagreed with explicit or human evidence. Both sides are kept; nothing is silently overwritten.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "speaker_id": { "type": "string", "minLength": 1 },
          "explicit_role": { "enum": ["tester", "device", "unknown"] },
          "semantic_role": { "enum": ["tester", "device", "unknown"] },
          "resolution": { "type": "string", "minLength": 1 },
          "needs_review": { "type": "boolean" }
        },
        "required": ["speaker_id", "explicit_role", "semantic_role", "resolution", "needs_review"],
        "additionalProperties": false
      }
    },
    "attributions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "speaker_id": { "type": "string", "minLength": 1 },
          "role": { "enum": ["tester", "device", "unknown"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "confidence_basis": {
            "description": "What the confidence number actually means. uncalibrated_model_self_report must never be read as a calibrated accuracy or used as a release threshold.",
            "enum": ["explicit_user_evidence", "human_review", "uncalibrated_model_self_report", "none", null]
          },
          "method": {
            "enum": ["explicit_evidence", "semantic_attribution", "human_attribution", "none"]
          },
          "evidence_refs": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "provider": { "type": ["string", "null"] },
          "model": { "type": ["string", "null"] },
          "prompt_version": { "type": ["string", "null"] },
          "invocation_id": { "type": ["string", "null"] },
          "needs_review": { "type": "boolean" },
          "reason": { "type": "string", "minLength": 1 }
        },
        "required": ["speaker_id", "role", "confidence", "method",
                     "evidence_refs", "provider", "model", "reason"],
        "additionalProperties": false
      }
    }
  },
  "required": ["schema_version", "document_id", "speaker_segments_ref",
               "status", "reason", "attributions"],
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "status": { "enum": ["insufficient_evidence"] } } },
      "then": { "properties": { "attributions": { "maxItems": 0 } } }
    }
  ]
}
