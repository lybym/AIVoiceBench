{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aivoicebench.local/schemas/test-case.schema.json",
  "title": "AIVoiceBench TestCase",
  "type": "object",
  "required": ["schema_version", "case_id", "case_version", "name", "category", "mode", "stimulus", "expected", "metrics"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0.0"},
    "case_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9_-]+$"},
    "case_version": {"type": "string"},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "category": {
      "type": "object",
      "required": ["level1", "level2"],
      "properties": {
        "level1": {"type": "string"},
        "level2": {"type": "string"},
        "level3": {"type": "string"}
      },
      "additionalProperties": false
    },
    "mode": {"enum": ["fixed_audio", "interactive", "multi_turn", "exploratory_agent"]},
    "stimulus": {
      "type": "object",
      "properties": {
        "segments": {
          "type": "array",
          "items": {
            "oneOf": [
              {"type": "object", "required": ["type", "text"], "properties": {"type": {"const": "tts"}, "text": {"type": "string"}, "asset_id": {"type": "string"}}, "additionalProperties": true},
              {"type": "object", "required": ["type", "duration_ms"], "properties": {"type": {"const": "silence"}, "duration_ms": {"type": "integer", "minimum": 0}}, "additionalProperties": false},
              {"type": "object", "required": ["type", "asset_id"], "properties": {"type": {"const": "audio_asset"}, "asset_id": {"type": "string"}}, "additionalProperties": true}
            ]
          }
        },
        "assets": {"type": "object", "additionalProperties": {"type": "string"}},
        "trigger": {"type": "object", "additionalProperties": true}
      },
      "additionalProperties": true
    },
    "expected": {"type": "object", "additionalProperties": true},
    "metrics": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "repeat": {"type": "integer", "minimum": 1, "default": 1},
    "environment_profile": {"type": ["string", "null"]},
    "tags": {"type": "array", "items": {"type": "string"}},
    "notes": {"type": "string"}
  },
  "additionalProperties": false
}
