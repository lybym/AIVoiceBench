{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aivoicebench.local/schemas/test-case.schema.json",
  "title": "AIVoiceBench TestCase 2.0.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "case_id": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9_-]+$"
    },
    "case_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "object",
      "properties": {
        "level1": {
          "enum": [
            "L1",
            "L2",
            "L3",
            "L4",
            "L5"
          ]
        },
        "level2": {
          "type": "string",
          "minLength": 1
        },
        "level3": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "level1",
        "level2"
      ],
      "additionalProperties": false
    },
    "capability_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "mode": {
      "enum": [
        "fixed_audio",
        "interactive",
        "multi_turn",
        "exploratory_agent"
      ]
    },
    "stimulus": {
      "type": "object"
    },
    "expected": {
      "type": "object",
      "properties": {
        "assertions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/assertion"
          },
          "minItems": 1
        },
        "reference_text": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "assertions"
      ],
      "additionalProperties": false
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "repeat": {
      "type": "integer",
      "minimum": 1
    },
    "case_timeout_ms": {
      "type": "integer",
      "minimum": 1
    },
    "golden_set": {
      "type": "object",
      "properties": {
        "set_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      },
      "required": [
        "set_id",
        "version"
      ],
      "additionalProperties": false
    },
    "environment_profile": {
      "type": "string",
      "minLength": 1
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "notes": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "case_id",
    "case_version",
    "name",
    "category",
    "capability_refs",
    "mode",
    "stimulus",
    "expected",
    "metrics",
    "case_timeout_ms"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "fixed_audio"
          }
        }
      },
      "then": {
        "properties": {
          "stimulus": {
            "type": "object",
            "properties": {
              "assets": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/asset"
                },
                "minItems": 1
              },
              "segments": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/segment"
                },
                "minItems": 1
              }
            },
            "required": [
              "assets",
              "segments"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "interactive"
          }
        }
      },
      "then": {
        "properties": {
          "stimulus": {
            "type": "object",
            "properties": {
              "assets": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/asset"
                },
                "minItems": 1
              },
              "prompt": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/segment"
                },
                "minItems": 1
              },
              "interruption": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/segment"
                },
                "minItems": 1
              },
              "trigger": {
                "$ref": "#/$defs/trigger"
              }
            },
            "required": [
              "assets",
              "prompt",
              "interruption",
              "trigger"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "multi_turn"
          }
        }
      },
      "then": {
        "properties": {
          "stimulus": {
            "type": "object",
            "properties": {
              "assets": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/asset"
                },
                "minItems": 1
              },
              "turns": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/turn"
                },
                "minItems": 2
              }
            },
            "required": [
              "assets",
              "turns"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "exploratory_agent"
          }
        }
      },
      "then": {
        "properties": {
          "stimulus": {
            "type": "object",
            "properties": {
              "agent": {
                "type": "object",
                "properties": {
                  "provider": {
                    "type": "string",
                    "minLength": 1
                  },
                  "model": {
                    "type": "string",
                    "minLength": 1
                  },
                  "config_profile": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
                  },
                  "instructions": {
                    "type": "string",
                    "minLength": 1
                  },
                  "max_turns": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "max_duration_ms": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "provider",
                  "model",
                  "config_profile",
                  "instructions",
                  "max_turns",
                  "max_duration_ms"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "agent"
            ],
            "additionalProperties": false
          }
        },
        "not": {
          "required": [
            "golden_set"
          ]
        }
      }
    }
  ],
  "$defs": {
    "segment": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "audio_asset"
            },
            "asset_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
            }
          },
          "required": [
            "type",
            "asset_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "tts"
            },
            "asset_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
            },
            "text": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "type",
            "asset_id",
            "text"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "silence"
            },
            "sample_count": {
              "type": "integer",
              "minimum": 1
            },
            "sample_rate_hz": {
              "const": 16000
            }
          },
          "required": [
            "type",
            "sample_count",
            "sample_rate_hz"
          ],
          "additionalProperties": false
        }
      ]
    },
    "asset": {
      "type": "object",
      "properties": {
        "asset_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "asset_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "format": {
          "type": "object",
          "properties": {
            "container": {
              "const": "wav"
            },
            "encoding": {
              "const": "PCM_S16LE"
            },
            "sample_rate_hz": {
              "const": 16000
            },
            "channels": {
              "const": 1
            }
          },
          "required": [
            "container",
            "encoding",
            "sample_rate_hz",
            "channels"
          ],
          "additionalProperties": false
        },
        "provenance": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "minLength": 1
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "voice": {
              "type": "string",
              "minLength": 1
            },
            "config": {
              "type": "object"
            },
            "generator_version": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
            }
          },
          "required": [
            "provider",
            "model",
            "voice",
            "config",
            "generator_version"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "asset_id",
        "path",
        "asset_version",
        "sha256",
        "format",
        "provenance"
      ],
      "additionalProperties": false
    },
    "trigger": {
      "type": "object",
      "properties": {
        "event": {
          "const": "device_speech_start"
        },
        "offset_ms": {
          "type": "integer",
          "minimum": 0
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1
        },
        "require_active_device_speech": {
          "const": true
        },
        "on_timeout": {
          "const": "block"
        },
        "on_early_speech_end": {
          "const": "block"
        }
      },
      "required": [
        "event",
        "offset_ms",
        "timeout_ms",
        "require_active_device_speech",
        "on_timeout",
        "on_early_speech_end"
      ],
      "additionalProperties": false
    },
    "turn": {
      "type": "object",
      "properties": {
        "turn_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "segments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/segment"
          },
          "minItems": 1
        },
        "wait_for": {
          "type": "object",
          "properties": {
            "event": {
              "const": "device_speech_end"
            },
            "timeout_ms": {
              "type": "integer",
              "minimum": 1
            },
            "on_timeout": {
              "const": "block"
            }
          },
          "required": [
            "event",
            "timeout_ms",
            "on_timeout"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "turn_id",
        "segments",
        "wait_for"
      ],
      "additionalProperties": false
    },
    "assertion": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "assertion_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
            },
            "evaluator": {
              "const": "deterministic"
            },
            "metric_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
            },
            "operator": {
              "enum": [
                "eq",
                "lt",
                "lte",
                "gt",
                "gte"
              ]
            },
            "value": {
              "type": [
                "number",
                "boolean",
                "string"
              ]
            }
          },
          "required": [
            "assertion_id",
            "evaluator",
            "metric_id",
            "operator",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "assertion_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
            },
            "evaluator": {
              "enum": [
                "llm_judge",
                "manual"
              ]
            },
            "metric_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
            },
            "rubric": {
              "type": "string",
              "minLength": 1
            },
            "requires_human_review": {
              "type": "boolean"
            }
          },
          "required": [
            "assertion_id",
            "evaluator",
            "metric_id",
            "rubric",
            "requires_human_review"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
