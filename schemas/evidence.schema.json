{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aivoicebench.local/schemas/evidence.schema.json",
  "title": "Evidence 1.0.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "evidence_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "artifact_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "track_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "time_base": {
      "enum": ["run_monotonic_ms", "audio_relative_ms"]
    },
    "start_ms": {
      "type": "number",
      "minimum": 0
    },
    "end_ms": {
      "type": "number",
      "minimum": 0
    },
    "source": {
      "enum": [
        "audio_signal",
        "asr",
        "device_log",
        "manual_annotation",
        "controller",
        "derived"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "transcript_excerpt": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "evidence_id",
    "artifact_id",
    "track_id",
    "time_base",
    "start_ms",
    "end_ms",
    "source",
    "confidence"
  ],
  "additionalProperties": false
}
