{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aivoicebench.local/schemas/finding.schema.json",
  "title": "Finding 2.0.0 / 2.1.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "enum": [
        "2.0.0",
        "2.1.0"
      ]
    },
    "finding_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "analysis_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "case_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "execution_kind": {
      "enum": [
        "hardware",
        "dry_run",
        "synthetic",
        "imported"
      ]
    },
    "kind": {
      "enum": [
        "defect",
        "observation"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "severity": {
      "enum": [
        "P0",
        "P1",
        "P2",
        "P3",
        null
      ]
    },
    "status": {
      "enum": [
        "open",
        "needs_verification",
        "confirmed",
        "fixed",
        "wont_fix",
        "duplicate"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "expected_behavior": {
      "type": "string",
      "minLength": 1
    },
    "actual_behavior": {
      "type": "string",
      "minLength": 1
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "attribution_status": {
      "enum": [
        "unknown",
        "suspected",
        "verified"
      ]
    },
    "attribution_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "suspected_layers": {
      "type": "array",
      "items": {
        "enum": [
          "wake_word",
          "vad",
          "endpoint",
          "asr",
          "aec",
          "network",
          "llm",
          "prompt",
          "context",
          "memory",
          "agent",
          "tool",
          "tts",
          "safety",
          "persona",
          "unknown"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "requires_log_verification": {
      "type": "boolean"
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "event_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "metric_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "turn_ids": {
      "type": "array",
      "description": "Turns this Finding is bound to. Finding 2.1.0 records them explicitly; each must resolve to the Turn of the linked events/metrics.",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "human_review": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "not_required",
            "required",
            "approved"
          ]
        },
        "reviewer": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "reviewed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "status",
        "reviewer",
        "reviewed_at"
      ],
      "additionalProperties": false
    },
    "origin": {
      "enum": [
        "golden",
        "exploratory",
        "manual"
      ]
    },
    "regression_case_candidate": {
      "type": "boolean"
    },
    "regression": {
      "type": "object",
      "properties": {
        "state": {
          "enum": [
            "candidate",
            "minimized",
            "frozen"
          ]
        },
        "minimal_reproduction": {
          "type": "string",
          "minLength": 1
        },
        "case_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "case_version": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "golden_set_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "golden_set_version": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "required": [
        "state",
        "minimal_reproduction",
        "case_id",
        "case_version",
        "golden_set_id",
        "golden_set_version"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "finding_id",
    "run_id",
    "case_id",
    "execution_kind",
    "kind",
    "title",
    "severity",
    "status",
    "description",
    "expected_behavior",
    "actual_behavior",
    "confidence",
    "attribution_status",
    "attribution_confidence",
    "suspected_layers",
    "requires_log_verification",
    "evidence_ids",
    "event_ids",
    "metric_ids",
    "human_review",
    "origin",
    "regression_case_candidate"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "defect"
          }
        }
      },
      "then": {
        "properties": {
          "severity": {
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3"
            ]
          }
        }
      },
      "else": {
        "properties": {
          "severity": {
            "type": "null"
          },
          "regression_case_candidate": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "attribution_status": {
            "const": "unknown"
          }
        }
      },
      "then": {
        "properties": {
          "suspected_layers": {
            "const": [
              "unknown"
            ]
          },
          "attribution_confidence": {
            "const": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "attribution_status": {
            "const": "suspected"
          }
        }
      },
      "then": {
        "properties": {
          "requires_log_verification": {
            "const": true
          },
          "suspected_layers": {
            "not": {
              "contains": {
                "const": "unknown"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "attribution_status": {
            "const": "verified"
          }
        }
      },
      "then": {
        "properties": {
          "requires_log_verification": {
            "const": false
          },
          "suspected_layers": {
            "not": {
              "contains": {
                "const": "unknown"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "regression_case_candidate": {
            "const": true
          }
        }
      },
      "then": {
        "required": [
          "regression"
        ],
        "properties": {
          "kind": {
            "const": "defect"
          },
          "status": {
            "enum": [
              "confirmed",
              "fixed"
            ]
          }
        }
      },
      "else": {
        "not": {
          "required": [
            "regression"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "human_review": {
            "properties": {
              "status": {
                "const": "approved"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "human_review": {
            "properties": {
              "reviewer": {
                "type": "string",
                "minLength": 1
              },
              "reviewed_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "human_review": {
            "properties": {
              "status": {
                "enum": [
                  "not_required",
                  "required"
                ]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "human_review": {
            "properties": {
              "reviewer": {
                "type": "null"
              },
              "reviewed_at": {
                "type": "null"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "severity": {
            "enum": [
              "P0",
              "P1"
            ]
          },
          "suspected_layers": {
            "contains": {
              "const": "safety"
            }
          }
        }
      },
      "then": {
        "properties": {
          "human_review": {
            "properties": {
              "status": {
                "enum": [
                  "required",
                  "approved"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "confirmed",
              "fixed"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "human_review": {
            "properties": {
              "status": {
                "enum": [
                  "not_required",
                  "approved"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "regression"
        ],
        "properties": {
          "regression": {
            "properties": {
              "state": {
                "const": "frozen"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "regression": {
            "properties": {
              "case_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
              },
              "case_version": {
                "type": "string",
                "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
              },
              "golden_set_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
              },
              "golden_set_version": {
                "type": "string",
                "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
              }
            }
          }
        }
      }
    }
  ]
}
