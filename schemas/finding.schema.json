{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aivoicebench.local/schemas/finding.schema.json",
  "title": "AIVoiceBench Finding",
  "type": "object",
  "required": ["schema_version", "finding_id", "run_id", "case_id", "title", "severity", "status", "description", "evidence", "suspected_layers"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0.0"},
    "finding_id": {"type": "string"},
    "run_id": {"type": "string"},
    "case_id": {"type": "string"},
    "title": {"type": "string", "minLength": 1},
    "severity": {"enum": ["P0", "P1", "P2", "P3"]},
    "status": {"enum": ["open", "needs_verification", "confirmed", "fixed", "wont_fix", "duplicate"]},
    "description": {"type": "string"},
    "expected_behavior": {"type": "string"},
    "actual_behavior": {"type": "string"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "suspected_layers": {
      "type": "array",
      "items": {"enum": ["wake_word", "vad", "endpoint", "asr", "aec", "network", "llm", "prompt", "context", "memory", "agent", "tool", "tts", "safety", "persona", "unknown"]},
      "minItems": 1
    },
    "requires_log_verification": {"type": "boolean", "default": false},
    "metric_ids": {"type": "array", "items": {"type": "string"}},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["artifact_id"],
        "properties": {
          "artifact_id": {"type": "string"},
          "event_ids": {"type": "array", "items": {"type": "string"}},
          "start_ms": {"type": ["number", "null"]},
          "end_ms": {"type": ["number", "null"]},
          "transcript_excerpt": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "regression_case_candidate": {"type": "boolean", "default": false}
  },
  "additionalProperties": false
}
