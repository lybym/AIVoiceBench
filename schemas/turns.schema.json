{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aivoicebench.local/schemas/turns.schema.json",
  "title": "Turns 1.0.0",
  "description": "Conversational turns built from fused segments. Each turn pairs a tester speech segment with the following device response.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "document_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "fused_document_id": {
      "type": ["string", "null"],
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "status": {
      "enum": ["complete", "partial", "insufficient_evidence"]
    },
    "reason": {
      "type": ["string", "null"]
    },
    "turns": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "turn_id": {
            "type": "string",
            "minLength": 1
          },
          "tester_segment_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "device_segment_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "response_id": {
            "type": ["string", "null"],
            "minLength": 1
          },
          "start_ms": {
            "type": "number",
            "minimum": 0
          },
          "end_ms": {
            "type": "number",
            "minimum": 0
          },
          "tester_speech_start_ms": {
            "type": ["number", "null"],
            "minimum": 0
          },
          "tester_speech_end_ms": {
            "type": ["number", "null"],
            "minimum": 0
          },
          "device_speech_start_ms": {
            "type": ["number", "null"],
            "minimum": 0
          },
          "device_speech_end_ms": {
            "type": ["number", "null"],
            "minimum": 0
          },
          "has_interruption": {
            "type": "boolean"
          },
          "has_overlap": {
            "type": "boolean"
          }
        },
        "required": [
          "turn_id",
          "tester_segment_ids",
          "device_segment_ids",
          "response_id",
          "start_ms",
          "end_ms",
          "tester_speech_start_ms",
          "tester_speech_end_ms",
          "device_speech_start_ms",
          "device_speech_end_ms",
          "has_interruption",
          "has_overlap"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "document_id",
    "fused_document_id",
    "status",
    "reason",
    "turns"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": ["insufficient_evidence"]
          }
        }
      },
      "then": {
        "properties": {
          "turns": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
