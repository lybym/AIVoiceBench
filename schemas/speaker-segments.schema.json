{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aivoicebench.local/schemas/speaker-segments.schema.json",
  "title": "SpeakerSegments 1.0.0",
  "description": "Speaker clustering output from a diarization provider. Contains speaker IDs and time ranges only — NOT tester/device roles. Role attribution is a separate step.",
  "type": "object",
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "document_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "source": {
      "type": "object",
      "properties": {
        "audio_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "duration_ms": { "type": "number", "minimum": 0 }
      },
      "required": ["audio_sha256", "duration_ms"],
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "description": "Speaker IDs are bound to one recording invocation and analysis revision. speaker_0 in one recording is NOT the same person as speaker_0 in another.",
      "properties": {
        "recording_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "invocation_id": { "type": ["string", "null"] },
        "analysis_id": { "type": ["string", "null"] },
        "native_response_sha256": { "type": ["string", "null"] }
      },
      "required": ["recording_sha256", "invocation_id", "analysis_id", "native_response_sha256"],
      "additionalProperties": false
    },
    "processor": {
      "type": "object",
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "api_version": { "type": ["string", "null"] },
        "config": { "type": "object" }
      },
      "required": ["provider", "model", "api_version", "config"],
      "additionalProperties": false
    },
    "invocation": {
      "type": ["object", "null"],
      "properties": {
        "invocation_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$" },
        "latency_ms": { "type": ["number", "null"], "minimum": 0 },
        "status": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "status": {
      "enum": ["complete", "partial", "insufficient_evidence"]
    },
    "reason": { "type": ["string", "null"] },
    "speaker_segments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "segment_id": { "type": "string", "minLength": 1 },
          "speaker_id": { "type": "string", "minLength": 1 },
          "native_speaker_id": { "type": ["string", "null"] },
          "start_ms": { "type": "number", "minimum": 0 },
          "end_ms": { "type": "number", "minimum": 0 },
          "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
          "timing_source": { "const": "audio_relative_ms" },
          "timestamp_source": {
            "type": "string",
            "description": "How the boundary was estimated. Provider utterance estimates are not precise acoustic onsets.",
            "minLength": 1
          },
          "source": { "const": "diarization" },
          "raw_message_index": { "type": ["integer", "null"], "minimum": 0 },
          "raw_utterance_index": { "type": ["integer", "null"], "minimum": 0 },
          "evidence_refs": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          }
        },
        "required": ["segment_id", "speaker_id", "native_speaker_id", "start_ms", "end_ms",
                     "confidence", "timing_source", "timestamp_source", "source",
                     "raw_message_index", "raw_utterance_index", "evidence_refs"],
        "additionalProperties": false
      }
    }
  },
  "required": ["schema_version", "document_id", "source", "scope", "processor",
               "invocation", "status", "reason", "speaker_segments"],
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "status": { "enum": ["insufficient_evidence"] } } },
      "then": { "properties": { "speaker_segments": { "maxItems": 0 } } }
    }
  ]
}
