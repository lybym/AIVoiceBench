{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aivoicebench.local/schemas/fused-segments.schema.json",
  "title": "FusedSegments 1.0.0",
  "description": "Unified speech segments with speaker role attribution. Fuses acoustic + ASR timing. Speaker roles are hypotheses, not ground truth, unless verified by human review.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "document_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "source": {
      "type": "object",
      "properties": {
        "acoustic_document_id": {
          "type": ["string", "null"],
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "transcript_document_id": {
          "type": ["string", "null"],
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "audio_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "duration_ms": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "acoustic_document_id",
        "transcript_document_id",
        "audio_sha256",
        "duration_ms"
      ],
      "additionalProperties": false
    },
    "attribution": {
      "type": "object",
      "properties": {
        "strategy": {
          "enum": ["alternating_heuristic", "diarization_provider", "llm_assisted", "manual", "none"]
        },
        "provider": {
          "type": ["string", "null"]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["strategy", "provider", "confidence", "note"],
      "additionalProperties": false
    },
    "status": {
      "enum": ["complete", "partial", "insufficient_evidence"]
    },
    "reason": {
      "type": ["string", "null"]
    },
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "segment_id": {
            "type": "string",
            "minLength": 1
          },
          "start_ms": {
            "type": "number",
            "minimum": 0
          },
          "end_ms": {
            "type": "number",
            "minimum": 0
          },
          "speaker_role": {
            "enum": ["tester", "device", "unknown"]
          },
          "speaker_id": {
            "type": ["string", "null"]
          },
          "speaker_cluster_confidence": {
            "type": ["number", "null"],
            "minimum": 0,
            "maximum": 1
          },
          "role_attribution_confidence": {
            "type": ["number", "null"],
            "minimum": 0,
            "maximum": 1
          },
          "acoustic_boundary_confidence": {
            "type": ["number", "null"],
            "minimum": 0,
            "maximum": 1
          },
          "acoustic_uncertainty_ms": {
            "type": ["number", "null"],
            "minimum": 0
          },
          "speaker_source": {
            "enum": ["acoustic", "diarization", "ambiguous", "heuristic", "llm", "manual"]
          },
          "timing_source": {
            "enum": ["acoustic", "asr", "fused"]
          },
          "text": {
            "type": ["string", "null"]
          },
          "acoustic_segment_id": {
            "type": ["string", "null"]
          },
          "asr_segment_id": {
            "type": ["string", "null"]
          },
          "speaker_evidence": {
            "description": "How speaker_id was obtained. ambiguous_overlap means the acoustic segment overlapped conflicting clusters and the segment abstained.",
            "enum": ["single_overlap", "split_multiple_speakers", "ambiguous_overlap", "none"]
          },
          "speaker_candidates": {
            "description": "Overlapping speaker clusters with their overlap duration, kept as reviewable evidence for the assignment or abstention.",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "speaker_id": {
                  "type": "string"
                },
                "overlap_ms": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "required": ["speaker_id", "overlap_ms"],
              "additionalProperties": false
            }
          },
          "segment_origin": {
            "enum": ["acoustic_segment", "speaker_split"]
          },
          "asr_start_ms": {
            "type": ["number", "null"],
            "minimum": 0
          },
          "asr_end_ms": {
            "type": ["number", "null"],
            "minimum": 0
          },
          "asr_speaker_id": {
            "description": "Speaker label the recognition service reported for the utterance that supplied this text. Only meaningful inside this speaker output scope.",
            "type": ["string", "null"]
          },
          "text_attribution": {
            "description": "How this segment's text was tied to a speaker. ambiguous_spans_speakers means the utterance crossed a speaker boundary and was withheld from every segment; single_segment means no split was needed; utterance_speaker means the recognition service labeled the utterance; contained_in_sub_segment means the utterance interval sat inside exactly one sub-segment. Text is never assigned by segment length.",
            "enum": ["none", "single_segment", "utterance_speaker", "contained_in_sub_segment", "ambiguous_spans_speakers"]
          },
          "start_boundary_source": {
            "description": "Origin of start_ms. provider_speaker_estimate edges must not carry acoustic boundary confidence or uncertainty.",
            "enum": ["acoustic_segment", "provider_speaker_estimate"]
          },
          "end_boundary_source": {
            "type": "string",
            "enum": ["acoustic_segment", "provider_speaker_estimate"]
          }
        },
        "required": [
          "segment_id",
          "start_ms",
          "end_ms",
          "speaker_role",
          "speaker_id",
          "speaker_cluster_confidence",
          "role_attribution_confidence",
          "acoustic_boundary_confidence",
          "acoustic_uncertainty_ms",
          "speaker_source",
          "timing_source",
          "text",
          "acoustic_segment_id",
          "asr_segment_id",
          "asr_start_ms",
          "asr_end_ms",
          "asr_speaker_id",
          "text_attribution",
          "start_boundary_source",
          "end_boundary_source",
          "speaker_evidence",
          "speaker_candidates",
          "segment_origin"
        ],
        "additionalProperties": false
      }
    },
    "unattributed_texts": {
      "description": "Utterances that provably span more than one speaker cluster. They are withheld from every segment rather than guessed onto one speaker, and kept here for human review. The original transcript artifact is unchanged.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "asr_segment_id": {
            "type": ["string", "null"]
          },
          "acoustic_segment_id": {
            "type": ["string", "null"]
          },
          "start_ms": {
            "type": ["number", "null"],
            "minimum": 0
          },
          "end_ms": {
            "type": ["number", "null"],
            "minimum": 0
          },
          "text": {
            "type": ["string", "null"]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["asr_segment_id", "acoustic_segment_id", "start_ms", "end_ms", "text", "reason"],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "document_id",
    "source",
    "attribution",
    "status",
    "reason",
    "unattributed_texts",
    "segments"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": ["insufficient_evidence"]
          }
        }
      },
      "then": {
        "properties": {
          "segments": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
