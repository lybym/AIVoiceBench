{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aivoicebench.local/schemas/analysis-output.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "analysis_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "kind": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "pending",
        "running",
        "complete",
        "partial",
        "insufficient_evidence",
        "failed"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "data": {
      "type": [
        "object",
        "array",
        "null"
      ]
    },
    "artifact_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
      },
      "uniqueItems": true
    },
    "data_artifact_ref": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "analysis_id",
    "kind",
    "status",
    "reason",
    "data",
    "artifact_refs",
    "data_artifact_ref"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "pending",
              "insufficient_evidence",
              "failed"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "null"
          }
        }
      }
    }
  ]
}
